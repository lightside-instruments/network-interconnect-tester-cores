diff --git a/drivers/net/ethernet/litex/litex_liteeth.c b/drivers/net/ethernet/litex/litex_liteeth.c
index 35f24e0f0..245a3a335 100644
--- a/drivers/net/ethernet/litex/litex_liteeth.c
+++ b/drivers/net/ethernet/litex/litex_liteeth.c
@@ -12,6 +12,7 @@
 #include <linux/module.h>
 #include <linux/of_net.h>
 #include <linux/platform_device.h>
+#include <linux/workqueue.h>
 
 #define LITEETH_WRITER_SLOT       0x00
 #define LITEETH_WRITER_LENGTH     0x04
@@ -34,11 +35,16 @@
 #define LITEETH_PHY_CRG_RESET     0x00
 #define LITEETH_MDIO_W            0x04
 #define LITEETH_MDIO_R            0x0C
+#define LITEETH_LINK_LOCKED       BIT(0)
+#define LITEETH_LINK_SYNCED       BIT(1)
+#define LITEETH_LINK_POLL_MS      250
 
 #define DRV_NAME	"liteeth"
 
 struct liteeth {
 	void __iomem *base;
+	void __iomem *link;
+	struct delayed_work link_work;
 	struct net_device *netdev;
 	struct device *dev;
 	u32 slot_size;
@@ -54,6 +60,26 @@ struct liteeth {
 	void __iomem *rx_base;
 };
 
+static void liteeth_update_carrier(struct liteeth *priv)
+{
+	const u32 ready = LITEETH_LINK_LOCKED | LITEETH_LINK_SYNCED;
+
+	if ((litex_read32(priv->link) & ready) == ready)
+		netif_carrier_on(priv->netdev);
+	else
+		netif_carrier_off(priv->netdev);
+}
+
+static void liteeth_poll_link(struct work_struct *work)
+{
+	struct liteeth *priv = container_of(to_delayed_work(work),
+					    struct liteeth, link_work);
+
+	liteeth_update_carrier(priv);
+	schedule_delayed_work(&priv->link_work,
+			      msecs_to_jiffies(LITEETH_LINK_POLL_MS));
+}
+
 static int liteeth_rx(struct net_device *netdev)
 {
 	struct liteeth *priv = netdev_priv(netdev);
@@ -131,7 +157,13 @@ static int liteeth_open(struct net_device *netdev)
 	litex_write8(priv->base + LITEETH_WRITER_EV_ENABLE, 1);
 	litex_write8(priv->base + LITEETH_READER_EV_ENABLE, 1);
 
-	netif_carrier_on(netdev);
+	if (priv->link) {
+		liteeth_update_carrier(priv);
+		schedule_delayed_work(&priv->link_work,
+				      msecs_to_jiffies(LITEETH_LINK_POLL_MS));
+	} else {
+		netif_carrier_on(netdev);
+	}
 	netif_start_queue(netdev);
 
 	return 0;
@@ -142,6 +174,8 @@ static int liteeth_stop(struct net_device *netdev)
 	struct liteeth *priv = netdev_priv(netdev);
 
 	netif_stop_queue(netdev);
+	if (priv->link)
+		cancel_delayed_work_sync(&priv->link_work);
 	netif_carrier_off(netdev);
 
 	litex_write8(priv->base + LITEETH_WRITER_EV_ENABLE, 0);
@@ -229,6 +263,7 @@ static int liteeth_probe(struct platform_device *pdev)
 	struct net_device *netdev;
 	void __iomem *buf_base;
 	struct liteeth *priv;
+	struct resource *link;
 	int irq, err;
 
 	netdev = devm_alloc_etherdev(&pdev->dev, sizeof(*priv));
@@ -251,6 +286,16 @@ static int liteeth_probe(struct platform_device *pdev)
 	if (IS_ERR(priv->base))
 		return PTR_ERR(priv->base);
 
+	link = platform_get_resource_byname(pdev, IORESOURCE_MEM, "link");
+	if (link) {
+		priv->link = devm_ioremap_resource(&pdev->dev, link);
+		if (IS_ERR(priv->link))
+			return PTR_ERR(priv->link);
+
+		INIT_DELAYED_WORK(&priv->link_work, liteeth_poll_link);
+		netif_carrier_off(netdev);
+	}
+
 	buf_base = devm_platform_ioremap_resource_byname(pdev, "buffer");
 	if (IS_ERR(buf_base))
 		return PTR_ERR(buf_base);
