# ice4pi iCE40HX1K-TQ144, 12 MHz oscillator and PMOD pins P1–P4.
set_io clk 21
set_io D1 99
set_io D2 98
set_io D3 97
set_io D4 96
set_io D5 95
set_io tx_p 78
set_io tx_n 79
set_io rx_p 80
set_io rx_n 81

# Raspberry Pi SPI0 CE1, separate from the configuration flash on CE0.
set_io spi_mosi 67
set_io spi_miso 68
set_io spi_clk 70
set_io spi_cs_n 128
